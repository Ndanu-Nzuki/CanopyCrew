# Normalize line endings to LF across macOS, Windows, and Linux (Codespaces / Cloud Run)
* text=auto eol=lf

# Explicitly enforce LF for container, shell, Python, and web files
*.sh text eol=lf
Dockerfile* text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.python-version text eol=lf
.env* text eol=lf

# Keep CRLF only for Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pyc binary
